# Copilot API Environment Configuration
# Copy this file to .env and modify as needed

# Trace folder for logging LLM requests and responses
# Used when --trace flag is enabled
# Default: ./traces (current working directory)
TRACE_OUTPUT_FOLDER=./traces

# Passive summaries for native Responses: usage, cache reads/writes, latency,
# attempt counts and keyed content fingerprints. No extra model requests.
# Disabled by default; accepts 1 or true. Full request tracing is not required.
# COPILOT_CACHE_DIAGNOSTICS=1

# Experimental native Responses prefix policy (off by default).
# Adds one explicit breakpoint to a leading developer message while retaining
# implicit history caching. Copilot acceptance/benefit must be checked separately.
# COPILOT_CACHE_POLICY=prefix-v1
# Optional stable per-account/workspace scope for generating a missing cache key.
# Client keys are never replaced. Do not share this scope across unrelated users.
# COPILOT_CACHE_NAMESPACE=my-account:my-workspace:v1

# Idle timeout in seconds for the Bun server
# Default: 255 seconds
IDLE_TIMEOUT=255

# Responses upstream response-header deadline in milliseconds. Set to 0 to disable.
# Default: 60000
# COPILOT_HEADER_TIMEOUT_MS=60000

# Optional streaming deadlines in milliseconds. They are disabled by default;
# set a positive value to enable one. SSE idle activity includes every upstream
# event, not only visible text tokens.
# COPILOT_FIRST_EVENT_TIMEOUT_MS=0
# COPILOT_STREAM_IDLE_TIMEOUT_MS=0
# COPILOT_TOTAL_TIMEOUT_MS=0

# Model mappings to redirect requests from one model to another
# Format: "source1:target1,source2:target2"
# Maps Claude Code's hyphenated model ids onto this fork's catalog ids.
# Uncomment to activate (same-series, lossless /v1/messages passthrough):
# MODEL_MAPPINGS="claude-opus-4-8:claude-opus-4.8,claude-opus-4-7:claude-opus-4.7,claude-opus-4-6:claude-opus-4.6,claude-sonnet-4-6:claude-sonnet-4.6,claude-sonnet-4-5:claude-sonnet-4.5,claude-opus-4-5:claude-opus-4.5,claude-haiku-4-5:claude-haiku-4.5"
# Cross-protocol example (Claude Code -> GPT via Responses bridge, lossy):
# MODEL_MAPPINGS="claude-opus-4-8:gpt-5.5,claude-sonnet-4-6:gpt-5.3-codex,claude-haiku-4-5:claude-haiku-4.5"

# Port of the Copilot Token Bridge VS Code extension (http://127.0.0.1:<port>/token)
# Default: 18774
# VSCODE_PROXY_PORT=18774
